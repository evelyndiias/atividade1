
/* Configurações gerais */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    color: #333;
}

/* Cabeçalho */
header {
    background-color: #1e293b;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: #38bdf8;
}

nav {
    display: flex;
    gap: 20px;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    color: #38bdf8;
}

/* Seção principal */
.principal {
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
    background-color: #dbeafe;
}

.principal h1 {
    font-size: 36px;
    margin-bottom: 20px;
    color: #1e3a8a;
}

.principal p {
    font-size: 18px;
    max-width: 550px;
    line-height: 1.6;
    margin-bottom: 25px;
}

/* Botão */
.botao {
    background-color: #2563eb;
    color: white;
    padding: 12px 25px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.3s;
}

.botao:hover {
    background-color: #1d4ed8;
}

/* Seção sobre */
.sobre {
    padding: 60px 20px;
    text-align: center;
}

.sobre h2 {
    margin-bottom: 15px;
    color: #1e3a8a;
}

.sobre p {
    line-height: 1.6;
}

/* Rodapé */
footer {
    background-color: #1e293b;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Adaptação para celulares */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        gap: 15px;
    }

    .principal h1 {
        font-size: 28px;
    }
}
